<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="models.ElectionsController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="1200"
      prefHeight="800">

    <!-- TITLE -->
    <children>
        <Label text="Irish Elections Management System">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <!-- BUTTON BAR -->
        <HBox alignment="CENTER" spacing="10">
            <children>
                <Button text="Add Politician" onAction="#addPolitician"/>
                <Button text="Edit Politician" onAction="#editPolitician"/>
                <Button text="Delete Politician" onAction="#deletePolitician"/>

                <Button text="Add Election" onAction="#addElection"/>
                <Button text="Edit Election" onAction="#editElection"/>
                <Button text="Delete Election" onAction="#deleteElection"/>

                <Button text="Add Candidate" onAction="#addCandidate"/>
                <Button text="Edit Candidate" onAction="#editCandidate"/>
                <Button text="Delete Candidate" onAction="#deleteCandidate"/>

                <Button text="Save Data" onAction="#saveData"/>
                <Button text="Load Data" onAction="#loadData"/>
                <Button text="Reset All" onAction="#resetAll"/>
            </children>
        </HBox>

        <!-- SEARCH BAR FOR POLITICIANS -->
        <HBox alignment="CENTER" spacing="10">
            <children>
                <TextField fx:id="searchPolName"   promptText="Search politician name..."   prefWidth="200"/>
                <TextField fx:id="searchPolParty"  promptText="Search party..."            prefWidth="200"/>
                <TextField fx:id="searchPolCounty" promptText="Search county..."           prefWidth="200"/>
                <Button text="Search Politicians" onAction="#searchPoliticians"/>
            </children>
        </HBox>

        <!-- SEARCH BAR FOR ELECTIONS -->
        <HBox alignment="CENTER" spacing="10">
            <children>
                <TextField fx:id="searchElectionType" promptText="Search election type..." prefWidth="200"/>
                <TextField fx:id="searchElectionYear" promptText="Search year..."         prefWidth="200"/>
                <Button text="Search Elections" onAction="#searchElections"/>
            </children>
        </HBox>

        <!-- MAIN CONTENT AREA -->
        <HBox alignment="TOP_CENTER" spacing="20" prefHeight="600">

            <!-- POLITICIANS COLUMN -->
            <VBox spacing="10">
                <children>
                    <Label text="Politicians:"/>
                    <ListView fx:id="politicianList" prefWidth="250" prefHeight="500"/>
                </children>
            </VBox>

            <!-- ELECTIONS COLUMN -->
            <VBox spacing="10">
                <children>
                    <Label text="Elections:"/>
                    <ListView fx:id="electionList" prefWidth="250" prefHeight="500"/>
                </children>
            </VBox>

            <!-- CANDIDATES COLUMN -->
            <VBox spacing="10">
                <children>
                    <Label text="Candidates (Selected Election):"/>
                    <ListView fx:id="candidateList" prefWidth="300" prefHeight="500"/>
                </children>
            </VBox>

            <!-- POLITICIAN DETAILS + DRILL DOWN -->
            <VBox spacing="10">
                <children>
                    <Label text="Politician Details:"/>
                    <Label fx:id="lblPoliticianDetails"
                           prefWidth="300"
                           prefHeight="120"
                           wrapText="true"
                           style="-fx-border-color: black; -fx-padding: 10;"/>

                    <Label text="Elections This Politician Ran In:"/>
                    <ListView fx:id="politicianElectionList" prefWidth="300" prefHeight="350"/>
                </children>
            </VBox>

        </HBox>

    </children>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

</VBox>